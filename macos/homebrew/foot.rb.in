# Generated by macos/publish.sh (gobijan/foot-macos), for each release
cask "foot" do
  version "@version@"
  sha256 "@sha256@"

  url "https://github.com/gobijan/foot-macos/releases/download/#{version}/foot-#{version}.zip"
  name "foot"
  desc "Fast, lightweight and minimalistic terminal emulator"
  homepage "https://github.com/gobijan/foot-macos"

  livecheck do
    url :url
    regex(/^v?(\d+(?:\.\d+)+-macos\.\d+)$/i)
    strategy :github_latest
  end

  auto_updates true
  depends_on macos: :sonoma

  app "foot.app"
  binary "#{appdir}/foot.app/Contents/MacOS/foot"
  binary "#{appdir}/foot.app/Contents/MacOS/footclient"

  zap trash: [
    "~/Library/Caches/io.github.gobijan.foot",
    "~/Library/HTTPStorages/io.github.gobijan.foot",
    "~/Library/Preferences/io.github.gobijan.foot.plist",
    "~/Library/Saved Application State/io.github.gobijan.foot.savedState",
  ]
end
