# -*- conf -*-
# Grok Night / Grok Day
#
# The Grok palette, dark and light, as in Ghostty's GrokNight and
# GrokDay, and Helix' grok-night and grok-day. Colors from
# xai-org/grok-build (Apache-2.0). These are also foot for macOS'
# default colors (macos/default-colors.c).
#
# In the light theme, white (regular7, bright7) is dark gray, so that
# text programs paint "white" (e.g. bat --theme=base16) stays readable.

[colors-dark]
cursor=0a0a0a bb9af7
foreground=e1e1e1
background=0a0a0a

regular0=111111
regular1=f7768e
regular2=9ece6a
regular3=e0af68
regular4=7aa2f7
regular5=bb9af7
regular6=1abc9c
regular7=c8c8c8

bright0=6c6c6c
